{
  "name": "@lenticule-science/software-change-proposal-assay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
